{
  "WorkflowMonitorApi": {
    "BaseUrl": "http://127.0.0.1:5080",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "Worker": {
    "Id": "CustomerCsvWorker"
  },
  "ConnectionStrings": {
    "WorkflowMonitor": "Server=YOUR_SQL_SERVER;Database=SqlWorkflowMonitor;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;"
  },
  "CsvImport": {
    "ProcessId": 1,
    "FileName": "customers.csv",
    "InputFolder": "C:\\SqlWorkflowMonitor\\Input",
    "ProcessedFolder": "C:\\SqlWorkflowMonitor\\Processed",
    "ErrorFolder": "C:\\SqlWorkflowMonitor\\Error",
    "IntervalSeconds": 60,
    "MaxFileSizeBytes": 10485760,
    "MaxRows": 100000,
    "MinimumFileAgeSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
