{
  "WorkflowMonitorApi": {
    "BaseUrl": "http://127.0.0.1:5080",
    "ApiKey": ""
  },

  "Worker": {
    "Id": "CustomerCsvWorker"
  },

  "ConnectionStrings": {
    "WorkflowMonitor": "Server=YOUR_SQL_SERVER;Database=SqlWorkflowMonitor;Integrated Security=True;TrustServerCertificate=True;"
  },

  "Monitoring": {
    "StaleExecutionMinutes": 10
  },

  "CsvImport": {
    "ProcessId": 1,
    "FileName": "customers.csv",
    "InputFolder": "C:\\SqlWorkflowMonitor\\Input",
    "ProcessedFolder": "C:\\SqlWorkflowMonitor\\Processed",
    "ErrorFolder": "C:\\SqlWorkflowMonitor\\Error",
    "IntervalSeconds": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}