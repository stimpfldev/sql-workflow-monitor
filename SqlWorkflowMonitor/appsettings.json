{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "WorkflowMonitor": "Server=YOUR_SQL_SERVER;Database=SqlWorkflowMonitor;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;"
  },
  "Licensing": {
    "LicenseFilePath": "License/sqlworkflowmonitor.lic",
    "PublicKeyFilePath": "Licensing/Keys/sqlworkflowmonitor-public.pem"
  },
  "Security": {
    "RequireHttps": false,
    "ApiKey": "",
    "Admin": {
      "Username": "",
      "PasswordHash": "",
      "PasswordSalt": ""
    }
  },
  "Monitoring": {
    "StaleExecutionMinutes": 10
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
